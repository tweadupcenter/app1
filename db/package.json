{
  "name": "@immo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "reset": "tsx src/migrate.ts --reset && tsx src/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "storage:to-s3": "tsx src/storage-to-s3.ts"
  },
  "dependencies": {
    "@immo/core": "workspace:*",
    "pg": "8.23.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/three": "0.187.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./password": "./src/password.ts",
    "./migrate": "./src/migrate.ts",
    "./seed": "./src/seed.ts"
  }
}
