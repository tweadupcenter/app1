# --- Base de données -------------------------------------------------------
# Rôle propriétaire (migrations uniquement, jamais utilisé par l'application)
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/immo360
# Mot de passe attribué au rôle applicatif immo_app lors des migrations
IMMO_APP_DB_PASSWORD=CHANGE_ME_APP
# Connexion de l'application et du worker (rôle immo_app, soumis à la RLS)
DATABASE_URL=postgres://immo_app:CHANGE_ME_APP@localhost:5432/immo360

# --- Application -----------------------------------------------------------
# Secret de signature des jetons internes (rendu vidéo). 32+ caractères aléatoires.
APP_SECRET=CHANGE_ME_WITH_32_RANDOM_CHARS_MINIMUM
# URL publique de l'application (utilisée par le worker pour le rendu vidéo)
APP_URL=http://localhost:3000
# Dossier de stockage privé des fichiers (hors du dossier public)
STORAGE_DIR=./storage
# Mot de passe des comptes de démonstration créés par le seed
SEED_PASSWORD=demo-immo-360

# --- Worker ----------------------------------------------------------------
# Chemin de Chromium pour le rendu vidéo (laisser vide pour Playwright par défaut)
CHROMIUM_PATH=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PDFTOPPM_PATH=pdftoppm

# --- Mode Unreal (non opérationnel tant que ces éléments manquent) --------
UNREAL_SIGNALLING_URL=
UNREAL_PROJECT_PACKAGED=
UNREAL_GPU_HOST=

# --- Assistance IA à la lecture des plans (désactivée) ---------------------
# Aucun plan n'est transmis à un fournisseur externe. Laisser vide.
PLAN_AI_PROVIDER=

# Domaines publics autorisés pour les formulaires derrière un proxy (ex. immo.example.ma). Séparés par des virgules.
ALLOWED_ORIGINS=
# Production (docker-compose.prod.yml)
POSTGRES_PASSWORD=CHANGE_ME
